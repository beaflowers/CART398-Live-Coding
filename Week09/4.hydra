
s0.initVideo("https://raw.githubusercontent.com/beaflowers/CART398-Live-Coding/main/Final/firetoflowers.mp4")
s1.initVideo("https://raw.githubusercontent.com/beaflowers/CART398-Live-Coding/main/Final/firelily.mp4")


src(s1)
  .modulate(osc(10, 3, 1))
  .add(voronoi(10))
.out(o1)
// render
src(s0)
  .modulate(src(s1), 0.5)
  .out(o0)