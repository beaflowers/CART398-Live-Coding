a.show()

a.setBins(4)     // number of frequency bins (default: 4)
a.setSmooth(0.4) // smoothing 0–1 (default: 0.4)
a.setCutoff(4)   // noise gate — values below this → 0
a.setScale(1)    // output amplitude scaling

a.fft[0]  // bin 0 — typically sub-bass
a.fft[1]  // bin 1 — bass / low-mids
a.fft[2]  // bin 2 — mids
a.fft[3]  // bin 3 — highs

//make shape sharper, larger, changing faster as time goes on 
shape(()=> Math.sin(time/1.5)+5, 0.2, 0.2) // moving shape ()=> Math.sin(time*1.5)+4
  //.repeat(1, 1) //fft[3]+2?, P for 2nd
  //.scrollY(-0.1, -0.1)
  .color(()=>a.fft[2], 0.9, 0.5) //fire flicker
  .brightness(0.001) //for beginning, darkness to sparks 
  //.brightness(()=> a.fft[1]-0.8) //afft?
  .layer(
    src(o1)
    .mask(o2)
    //.colorama(0.3) //not with brightness! before
    //.modulate(osc(1, Math.sin(time)*6, 0.8)) //push the energy
    .luma(0.9, 0.2) //decrease first number for more texture 
  )
.out(o1)

render(o1)

//the above will be the layer that's quiet with sound reactive sparkles related to brightness

//below is the modulating layer creating texture... want to build to something with the beat reactive shape too ideally? it sort of transforms?
 osc(40, 0.05, 15)
  .modulate(osc(10, 1, 8).rotate(Math.sin(time/4)+360).colorama(0.8).brightness(-0.9).color(0.8, 0, 0.5))
  .rotate(Math.sin(time)+4)
  .diff(noise(5, 0.5, 0.5))
  .colorama(0.3)
  .brightness(-1) //make higher! 
  //.kaleid(P("3 4 5"))
  
  .glow(osc(3, 2, 1)
        .colorama(0.3)
        .rotate(()=> Math.sin(time/6)*3)
        .modulate(noise(6, 1, 1).kaleid(3).color(1, 0, 0)
                 )
       )
.out(o2)

