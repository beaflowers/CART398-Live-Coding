samples('github:tidalcycles/dirt-samples')

setcps(115/60/4)

// $: s("compurhythm78_bd ~ ~ compurhythm78_bd ~")
//   .ply(3)


$: s("[~ rim ~ rim*2]").bank("dr550")
  .gain(0.3)
  .room(0.3)
  .sometimes(x=>x.late().ply(2).struct("x ~ x ~"))


$: s("kr55_hh ~ kr55_hh ~ ~ kr55_hh ~ ~ ~")
  .gain(0.3)
  .sometimes(x=>x.degradeBy(0.7).ply(2))

$: s("~ rolandjd990_bd ~ [rolandjd990_bd rolandjd990_bd]")
  .room(0.8)
  .gain(0.2)
  .every(4, x=>x.degradeBy(0.3))


$: s("bd bd bd bd, [[~ hh] [~ hh]]*2")
  .delay(0.6)
  .degradeBy(0.8)
  .every(4, x=>x.ply(2))