samples('github:beaflowers/LiveCoding')

$: s("[kick:2 kick:1*2]*2")
   .every(4, x=>x.ply(2))

$: s("jd990_bd akailinn_sh ~ [jd990_bd jd990_bd]/2 ~").every(2, x=>x.struct("x ~ x x"))

$: s("<~ ~ ~ vocals:1 ~ ~ ~>").begin(0.35).speed("<1 2 1 3>").sometimes(x=>x.rev())
$: s("<effects ~ ~ ~ vocals ~ ~ ~>").sometimes(x=>x.room(0.8).size(10)).room(0.3)

$: s("~ hh ~ hh*2").bank('compurhythm78')
  .room(0.3)
  .sometimes(x=>x.struct("x ~ ~ x").room(0.8).size(10))
  .every(2, x=>x.ply(2))
  .gain(0.3)
  .lfo("<500 1000 3000>")

