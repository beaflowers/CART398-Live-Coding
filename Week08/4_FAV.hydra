shape(()=>Math.sin(time)+1*3, 0.4, 0.1)
  .repeat(5,3)
  .scrollY(-0.5, -0.1)
  //.color(0.8, 0, 0.5)
  .modulate(osc(1, Math.sin(time)*6, 0.8))
  .diff(voronoi(5, 2, 0.2).colorama(0.4).luma(0.3).invert())
  .layer(
    src(o1)
    .mask(o0)
    .luma(0.01, 0.1)
  )
.out(o0)

osc(40, 0.05, 15)
  .modulate(osc(10, 1, 8).rotate(Math.sin(time/4)+360).colorama(0.8).brightness(-0.4).color(0.8, 0, 0.5))
  .rotate(Math.sin(time)+4)
  .diff(noise(5, 0.5, 0.5))
.out(o1)

render(o0)
