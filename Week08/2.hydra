
osc(4, 0.3, 6)
.modulate(voronoi(90, 0.2, 0.4), 0.5).add(noise(2, 0.1, 2))
.modulatePixelate(noise(2, 0.1,1),100)
.colorama(()=> Math.sin(time/2))
.mult(shape(13, 0.9, 0.003))
.saturate(()=> Math.sin(time)*10)
.out(o0)

src(o0)
.diff(shape(()=>Math.sin(8) *4 ), 0.4).color(1, 0, 0).saturate(4))
.diff(noise(4, 0.2, 1))
.blend(osc(4, 0.2, 6)
      .rotate(()=> Math.sin(time*2))
      .color(0,1,0))
.out(o1)

.render(o1)⁠⁠⁠





